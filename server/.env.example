# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/nexlab
MONGODB_URI_PROD=your-production-uri

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# Security
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# Python Execution
PYTHON_PATH=python3
EXECUTION_TIMEOUT=10000
MAX_CODE_SIZE=100000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads